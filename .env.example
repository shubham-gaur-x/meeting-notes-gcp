# meeting-notes-gcp — environment template
#
# Copy to .env and fill in yourself. NEVER commit .env.
# NEVER paste real credentials into a chat or AI assistant.
#
# In deployed environments these come from Secret Manager, injected by Cloud Run.
# Locally they come from .env. Either way, meeting_notes/config.py is the ONLY module
# that reads them (ADR-011).

# ─── GCP ──────────────────────────────────────────────────────────────────────
# Never hardcode these in source. Terraform supplies them per environment.
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Four backends, all behind one protocol in meeting_notes/llm_client.py (ADR-014):
#
#   fake      replays recorded fixtures. No credentials, no network. Tier 0
#             default — this is what makes `make demo` work on a fresh clone.
#   gemini    direct AI Studio API key. No GCP project, no billing. Tier 1.
#   lmstudio  local models. Needs LM Studio running with both models loaded.
#   vertex    production. Needs a GCP project with billing.
#
LLM_BACKEND=fake                    # fake | gemini | lmstudio | vertex

# Gemini via AI Studio — the cheapest way to see real extraction.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Vertex AI. Confirm current model names at build time — they change.
VERTEX_CHAT_MODEL=
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_LOCATION=us-central1

# LM Studio — local development only. Must be running on the host.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Embeddings are 768-dim in BOTH backends because the Memgraph vector indexes are
# configured for 768. Changing this means migrating both indexes.
EMBEDDING_DIMENSION=768

# ─── Postgres ─────────────────────────────────────────────────────────────────
# The values below are the LOCAL defaults and match docker-compose.local.yml
# exactly — `make demo-up` then works with no edits.
#
# For deployed environments, set CLOUD_SQL_CONNECTION_NAME and db.py switches to
# the Cloud SQL connector instead of a plain DSN (ADR-015). Leave it blank for
# local, and the values above are used as-is.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meeting_memory
POSTGRES_USER=meeting_notes
POSTGRES_PASSWORD=local_dev_only    # Secret Manager: postgres-password (deployed)
CLOUD_SQL_CONNECTION_NAME=          # project:region:instance — blank = local Postgres

# ─── Memgraph ─────────────────────────────────────────────────────────────────
# Local defaults match docker-compose.local.yml. Memgraph runs unauthenticated
# locally; the deployed VM takes its credentials from Secret Manager.
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=                  # Secret Manager: memgraph-password (deployed)

# ─── Google Workspace OAuth ───────────────────────────────────────────────────
# Read docs/GOOGLE_AUTH.md before touching any of this.
# On the personal GCP project the refresh token EXPIRES EVERY 7 DAYS.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=         # Secret Manager: google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=               # Secret Manager: google-refresh-token
GOOGLE_WORKSPACE_USER=              # e.g. shubham.gaur@onixnet.com

# Google Meet transcript capture — Pub/Sub PULL subscription, no inbound endpoint.
# Leave unset to disable transcript ingestion cleanly (no-op, not an error).
MEET_PUBSUB_SUBSCRIPTION=           # projects/<p>/subscriptions/<s>

# ─── Jira ─────────────────────────────────────────────────────────────────────
# false for tier 0 and tier 1 — the pipeline runs fully and simply creates no
# tickets. `make demo` never writes to a real Jira.
JIRA_ENABLED=false
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=                     # Secret Manager: jira-api-token
JIRA_PROJECT_KEY=SCRUM
JIRA_BOARD_ID=1
JIRA_ISSUE_TYPE=Task

# Below this extraction confidence an ActionItem becomes needs_review, not a ticket.
JIRA_CONFIDENCE_THRESHOLD=0.6
JIRA_DEDUP_ENABLED=true
JIRA_DEDUP_THRESHOLD=0.9

# ─── Governance ───────────────────────────────────────────────────────────────
# Read-time floor on Fact confidence in person_memory_profile.
FACT_MIN_CONFIDENCE=0.5
# JSON roster for deterministic person resolution. Empty = no roster.
PERSON_ROSTER_PATH=

# ─── Pipeline tuning ──────────────────────────────────────────────────────────
CLASSIFIER_SCORE_THRESHOLD=0.40
PIPELINE_BATCH_SIZE=50
GRAPH_WRITE_CONCURRENCY=3

# ─── Service ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
GITHUB_WEBHOOK_SECRET=              # Secret Manager: github-webhook-secret
