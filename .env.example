# meeting-notes-gcp — environment template
#
# Copy to .env and fill in yourself. NEVER commit .env.
# NEVER paste real credentials into a chat or AI assistant.
#
# In deployed environments these come from Secret Manager, injected by Cloud Run.
# Locally they come from .env. Either way, meeting_notes/config.py is the ONLY module
# that reads them (ADR-011).

# ─── GCP ──────────────────────────────────────────────────────────────────────
# Never hardcode these in source. Terraform supplies them per environment.
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Zone for zonal resources — the Memgraph VM and disk. Required by
# scripts/sync.py (a disk snapshot is a zonal operation; must match
# terraform/envs/<env>.tfvars' `zone`).
GCP_ZONE=us-central1-a

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Three backends, all behind one protocol in meeting_notes/llm_client.py (ADR-014):
#
#   fake      replays recorded fixtures. No credentials, no network. Tier 0
#             default — this is what makes `make demo` work on a fresh clone.
#   gemini    direct AI Studio API key. No GCP project, no billing. Tier 1.
#   vertex    production. Needs a GCP project with billing.
#
LLM_BACKEND=fake                    # fake | gemini | vertex

# Gemini via AI Studio — the cheapest way to see real extraction.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Vertex AI. All three values below were CONFIRMED against the live API on
# 2026-08-20, not assumed — model names do change, so re-check rather than
# trusting this comment indefinitely.
#   gemini-3.7-flash     responds from location "global"
#   text-embedding-005   returns exactly 768 dims, already unit-normalised
# VERTEX_LOCATION=global is deliberate (ADR-021): the Gemini 3.x models are
# served ONLY from "global"; us-central1 has nothing newer than 2.5. Note
# "global" is not a region — the host is aiplatform.googleapis.com with no
# location prefix, which llm_client._vertex_host handles.
VERTEX_CHAT_MODEL=gemini-3.7-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_LOCATION=global

# Embeddings are 768-dim in EVERY backend because the Memgraph vector indexes are
# configured for 768. Changing this means migrating both indexes.
EMBEDDING_DIMENSION=768

# ─── Postgres ─────────────────────────────────────────────────────────────────
# The values below are the LOCAL defaults and match docker-compose.local.yml
# exactly — `make demo-up` then works with no edits.
#
# For deployed environments, set CLOUD_SQL_CONNECTION_NAME and db.py switches to
# the Cloud SQL connector instead of a plain DSN (ADR-015). Leave it blank for
# local, and the values above are used as-is.
POSTGRES_HOST=localhost
# 55432, not 5432 — see the port note in docker-compose.local.yml.
POSTGRES_PORT=55432
POSTGRES_DB=meeting_memory
POSTGRES_USER=meeting_notes
POSTGRES_PASSWORD=local_dev_only    # Secret Manager: postgres-password (deployed)
CLOUD_SQL_CONNECTION_NAME=          # project:region:instance — blank = local Postgres

# Populated from `terraform -chdir=terraform/ephemeral output` after `make sync-up`.
# These change on every sync-up because the instance is recreated (ADR-016).
GCS_BACKUP_BUCKET=                  # <project-id>-backups, created by the durable tier

# ─── Memgraph ─────────────────────────────────────────────────────────────────
# Local defaults match docker-compose.local.yml. Memgraph runs unauthenticated
# locally; the deployed VM takes its credentials from Secret Manager.
#
# Deployed Bolt is NOT publicly reachable (ADR-016). Open a tunnel first:
#   gcloud compute start-iap-tunnel meeting-notes-memgraph 7687 \
#     --local-host-port=localhost:7687 --zone=$GCP_ZONE
# then leave MEMGRAPH_HOST as localhost.
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=57687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=                  # Secret Manager: memgraph-password (deployed)

# ─── Google Workspace OAuth ───────────────────────────────────────────────────
# Read docs/GOOGLE_AUTH.md before touching any of this.
# On the personal GCP project the refresh token EXPIRES EVERY 7 DAYS.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=         # Secret Manager: google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=               # Secret Manager: google-refresh-token
GOOGLE_WORKSPACE_USER=              # e.g. shubham.gaur@onixnet.com

# Google Meet transcript capture — Pub/Sub PULL subscription, no inbound endpoint.
# Leave unset to disable transcript ingestion cleanly (no-op, not an error).
MEET_PUBSUB_SUBSCRIPTION=           # projects/<p>/subscriptions/<s>

# ─── Jira ─────────────────────────────────────────────────────────────────────
# false for tier 0 and tier 1 — the pipeline runs fully and simply creates no
# tickets. `make demo` never writes to a real Jira.
JIRA_ENABLED=false
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=                     # Secret Manager: jira-api-token
JIRA_PROJECT_KEY=SCRUM
JIRA_BOARD_ID=1
JIRA_ISSUE_TYPE=Task

# Below this extraction confidence an ActionItem becomes needs_review, not a ticket.
JIRA_CONFIDENCE_THRESHOLD=0.6
JIRA_DEDUP_ENABLED=true
JIRA_DEDUP_THRESHOLD=0.9

# ─── Governance ───────────────────────────────────────────────────────────────
# Read-time floor on Fact confidence in person_memory_profile.
FACT_MIN_CONFIDENCE=0.5
# JSON roster for deterministic person resolution. Empty = no roster.
PERSON_ROSTER_PATH=

# ─── Pipeline tuning ──────────────────────────────────────────────────────────
CLASSIFIER_SCORE_THRESHOLD=0.40
PIPELINE_BATCH_SIZE=50
GRAPH_WRITE_CONCURRENCY=3

# ─── Service ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
GITHUB_WEBHOOK_SECRET=              # Secret Manager: github-webhook-secret

# ─── Dev agent (Phase 11, ADR-020/ADR-021) ────────────────────────────────────
# Coding-model routing, DELIBERATELY separate from LLM_BACKEND above: this
# spawns a `gemini` CLI subprocess with tool access, not a chat_json call.
# `gemini` is the only backend (ADR-021) — Claude on Vertex is a Marketplace
# purchase the GCP free-trial credit does not cover, and local models are out
# of scope for this project.
DEV_AGENT_LLM_BACKEND=gemini
# Confirmed live 2026-08-20: completes real coding tasks from "global".
DEV_AGENT_GEMINI_MODEL=gemini-3-pro-preview
DEV_AGENT_GEMINI_LOCATION=global
# Config dir the agent OWNS. Without it the CLI reads the developer's own
# ~/.gemini/settings.json, whose auth selection wins over the environment and
# silently routes to Code Assist instead of Vertex (observed live).
DEV_AGENT_GEMINI_CLI_HOME=/tmp/dev-agent/gemini-home

DEV_AGENT_REPO_DIR=/tmp/dev-agent/repo
DEV_AGENT_WORK_ROOT=/tmp/dev-agent/worktrees
DEV_AGENT_TIMEOUT_SECONDS=1800
DEV_AGENT_MAX_ATTEMPTS=1
DEV_AGENT_POLL_BATCH_SIZE=5

# Review guardrails (ADR-020). Seven deterministic gates run inside the agent's
# worktree after it opens a PR; any failure escalates the run to NEEDS_HUMAN
# instead of SHIPPED, and the PR is left open for a person.
# The commands run via `python -m` so they resolve to the interpreter running
# the job -- a bare `ruff`/`mypy` is not on PATH in a fresh worktree.
DEV_AGENT_TEST_COMMAND=python -m pytest -q
DEV_AGENT_LINT_COMMAND=python -m ruff check .
DEV_AGENT_TYPECHECK_COMMAND=python -m mypy meeting_notes
DEV_AGENT_GATE_TIMEOUT_SECONDS=900
DEV_AGENT_MAX_DIFF_FILES=10
DEV_AGENT_MAX_DIFF_LINES=600

GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=                       # Secret Manager: github-token
